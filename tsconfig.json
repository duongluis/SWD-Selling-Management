{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
       "@firebase/auth": ["./node_modules/@firebase/auth/dist/index.rn.d.ts"],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/_layout.tsx",
    "app/index.jsx",
    "app/auth/signIn.tsx",
    "app/(tabs)/order.tsx",
    "app/(tabs)/customer.tsx",
    "app/(tabs)/*.jsx",
    "nativewind-env.d.ts"
  ]
}