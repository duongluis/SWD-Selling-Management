{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/_layout.jsx",
    "app/index.jsx",
    "app/auth/signIn.jsx",
    "app/(tabs)/order.jsx",
    "app/(tabs)/customer.jsx",
    "app/(tabs)/*.jsx",
    "nativewind-env.d.ts"
  ]
}